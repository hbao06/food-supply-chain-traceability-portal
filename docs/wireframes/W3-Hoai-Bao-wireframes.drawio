ry x="1050" y="314" width="340" height="30" as="geometry" /></mxCell><mxCell id="134" value="Báo lỗi tải dữ liệu, có “Thử lại”; không dùng dữ liệu mẫu." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;strokeColor=#c8c8c8;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1050" y="344" width="340" height="62" as="geometry" /></mxCell><mxCell id="135" value="Mobile 360 px" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacingLeft=10;fillColor=#e8f5e9;strokeColor=#9aa0a6;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1050" y="420" width="340" height="30" as="geometry" /></mxCell><mxCell id="136" value="Thông tin lô nằm trước timeline; timeline xếp dọc, không cuộn ngang toàn trang." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;strokeColor=#c8c8c8;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1050" y="450" width="340" height="62" as="geometry" /></mxCell></root>
