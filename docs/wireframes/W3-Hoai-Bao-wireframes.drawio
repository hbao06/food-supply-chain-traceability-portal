eometry x="1050" y="314" width="340" height="30" as="geometry" /></mxCell><mxCell id="107" value="Thông báo chung: “Email hoặc mật khẩu không đúng”. Không tiết lộ tài khoản tồn tại." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;strokeColor=#c8c8c8;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1050" y="344" width="340" height="62" as="geometry" /></mxCell><mxCell id="108" value="Tài khoản PENDING / LOCKED" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacingLeft=10;fillColor=#f3e8ff;strokeColor=#9aa0a6;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1050" y="420" width="340" height="30" as="geometry" /></mxCell><mxCell id="109" value="Hiển thị thông báo theo trạng thái; không chuyển vào dashboard." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;strokeColor=#c8c8c8;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1050" y="450" width="340" height="62" as="geometry" /></mxCell></root>
