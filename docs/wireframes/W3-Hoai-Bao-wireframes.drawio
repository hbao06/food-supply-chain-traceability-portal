<diagram name="05 - Quy tắc điều hướng W3" id="navigation-w3"><mxGraphModel grid="1" gridSize="8" page="1" pageWidth="1440" pageHeight="900"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="137" value="W3 — Quy tắc điều hướng giao diện" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=26;align=left;verticalAlign=middle;spacingLeft=18;fillColor=#1f2937;strokeColor=#1f2937;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1360" height="60" as="geometry" /></mxCell><mxCell id="138" value="Consumer" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;align=center;verticalAlign=middle;fillColor=#e8f5e9;strokeColor=#6b7280;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="260" height="54" as="geometry" /></mxCell><mxCell id="139" value="Trang tra cứu UI-01 → nhập mã hợp lệ → Kết quả UI-02&#10;QR hợp lệ → mở trực tiếp UI-02&#10;Không tìm thấy / QR sai → ở trang lỗi → quay lại UI-01" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="370" y="130" width="950" height="80" as="geometry" /></mxCell><mxCell id="140" value="Người dùng nội bộ" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;align=center;verticalAlign=middle;fillColor=#e8f0fe;strokeColor=#6b7280;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="250" width="260" height="54" as="geometry" /></mxCell><mxCell id="141" value="UI-03 Đăng nhập → UI-05 Dashboard → chọn lô → UI-09 Chi tiết&#10;UI-09 → thao tác theo quyền: UI-08 Tạo lô / UI-10 Cập nhật / UI-11 Thêm sự kiện&#10;Menu Hồ sơ → UI-06; Đăng xuất → xóa phiên → UI-03" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="370" y="250" width="950" height="80" as="geometry" /></mxCell><mxCell id="142" value="Bảo vệ phiên" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;align=center;verticalAlign=middle;fillColor=#fff4cc;strokeColor=#6b7280;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="370" width="260" height="54" as="geometry" /></mxCell><mxCell id="143" value="Mở UI-05/UI-06 khi chưa đăng nhập → chuyển UI-03.&#10;Phiên hết hạn khi gọi API → xóa phiên, báo hết hạn, chuyển UI-03.&#10;Consumer dùng UI-01/UI-02 không bị bắt đăng nhập." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="370" y="370" width="950" height="80" as="geometry" /></mxCell><mxCell id="144" value="Quyền truy cập" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;align=center;verticalAlign=middle;fillColor=#fde2e2;strokeColor=#6b7280;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="490" width="260" height="54" as="geometry" /></mxCell><mxCell id="145" value="Ẩn menu ngoài quyền; nếu truy cập trực tiếp và API từ chối → thông báo không có quyền.&#10;Không hiển thị dữ liệu bảo vệ; có nút quay về Dashboard." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="370" y="490" width="950" height="80" as="geometry" /></mxCell><mxCell id="146" value="Thao tác chung" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;align=center;verticalAlign=middle;fillColor=#f3e8ff;strokeColor=#6b7280;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="610" width="260" height="54" as="geometry" /></mxCell><mxCell id="147" value="Gửi form: khóa nút trong lúc xử lý.&#10;Lỗi tải: giữ dữ liệu đã nhập và cho Thử lại.&#10;Nút Quay lại giữ ngữ cảnh trước đó; không dùng dữ liệu mẫu thay dữ liệu API." style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="370" y="610" width="950" height="80" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>