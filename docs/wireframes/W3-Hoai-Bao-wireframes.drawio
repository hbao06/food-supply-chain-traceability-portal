Geometry x="90" y="444" width="260" height="45" as="geometry" /></mxCell><mxCell id="232" value="Nông trại A  (chỉ xem)" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#f4f5f7;strokeColor=#9ca3af;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="360" y="444" width="590" height="45" as="geometry" /></mxCell><mxCell id="233" value="Lưu tên" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#1f3b73;strokeColor=#1f3b73;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="510" width="175" height="48" as="geometry" /></mxCell><mxCell id="234" value="Đổi mật khẩu" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#e8f0fe;strokeColor=#6b8fd6;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="75" y="600" width="900" height="43" as="geometry" /></mxCell><mxCell id="350" value="Mật khẩu hiện tại" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="90" y="658" width="275" height="52" as="geometry" /></mxCell><mxCell id="351" value="Mật khẩu mới" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="380" y="658" width="275" height="52" as="geometry" /></mxCell><mxCell id="352" value="Xác nhận mật khẩu mới" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="670" y="658" width="275" height="52" as="geometry" /></mxCell><mxCell id="236" value="Cập nhật mật khẩu" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#1f3b73;strokeColor=#1f3b73;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="732" width="250" height="48" as="geometry" /></mxCell><mxCell id="237" value="Tải và lưu" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#e8f0fe;strokeColor=#6b8fd6;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="122" width="350" height="36" as="geometry" /></mxCell><mxCell id="238" value="Đang tải: báo trạng thái. Lỗi tải: Thử lại. Đang lưu: khóa nút. Chỉ báo thành công khi API xác nhận." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#ffffff;strokeColor=#c8c8c8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1040" y="158" width="350" height="116" as="geometry" /></mxCell><mxCell id="239" value="Lỗi form" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#e8f0fe;strokeColor=#6b8fd6;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="298" width="350" height="36" as="geometry" /></mxCell><mxCell id="240" value="Tên trống, mật khẩu cũ sai hoặc xác nhận không khớp: báo lỗi. Giữ tên, xóa các ô mật khẩu sau khi đổi thành công." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#ffffff;strokeColor=#c8c8c8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1040" y="334" width="350" height="116" as="geometry" /></mxCell><mxCell id="241" value="Quyền chỉnh sửa" style="rounded=0;wh