o tác chính" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#e8f0fe;strokeColor=#6b8fd6;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="845" y="125" width="535" height="54" as="geometry" /></mxCell><mxCell id="247" value="Farmer" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#f8f9fa;strokeColor=#c8c8c8;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="179" width="200" height="108" as="geometry" /></mxCell><mxCell id="248" value="Lô thuộc đơn vị; hồ sơ; đăng xuất" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#f8f9fa;strokeColor=#c8c8c8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="255" y="179" width="590" height="108" as="geometry" /></mxCell><mxCell id="249" value="Tạo lô mới, mở chi tiết lô" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#f8f9fa;strokeColor=#c8c8c8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="845" y="179" width="535" height="108" as="geometry" /></mxCell><mxCell id="250" value="Processor" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#ffffff;strokeColor=#c8c8c8;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="287" width="200" height="108" as="geometry" /></mxCell><mxCell id="251" value="Lô được phép xử lý; hồ sơ; đăng xuất" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#ffffff;strokeColor=#c8c8c8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="255" y="287" width="590" height="108" as="geometry" /></mxCell><mxCell id="252" value="Mở lô, ghi sự kiện chế biến/đóng gói" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#ffffff;strokeColor=#c8c8c8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="845" y="287" width="535" height="108" as="geometry" /></mxCell><mxCell id="253" value="Distributor" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#f8f9fa;strokeColor=#c8c8c8;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="395" width="200" height="108" as="geometry" /></mxCell><mxCell id="254" value="Lô được phép tiếp nhận/vận chuyển; hồ sơ; đăng xuất" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#f8f9fa;strokeColor=#c8c8c8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="255" y="395" width="590" height="108" as="geometry" /></mxCell><mxCell id="255" value="Mở lô, ghi sự kiện vận chuyển/phân phối" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#f8f9fa;strokeColor=#c8c8c8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="845" y="395" width="535" height="108" as="geometry" /></mxCell><mxCell id="256" value="Admin" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#ffffff;strokeColor=#c8c8c8;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="503" width="200" height="108" as="geometry" /></mxCell><mxCell id="257" value="Danh sách lô; người dùng; đơn vị; audit; hồ sơ" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#ffffff;strokeCo