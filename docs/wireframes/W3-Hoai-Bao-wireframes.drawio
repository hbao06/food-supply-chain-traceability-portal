acingRight=12;fillColor=#f8f9fa;strokeColor=#c8c8c8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1070" y="613" width="310" height="108" as="geometry" /></mxCell><mxCell id="280" value="Dashboard: danh sách rỗng chỉ khi API trả thành công với 0 lô; lỗi tải có Thử lại. Trang công khai không yêu cầu đăng nhập." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#e8f5e9;strokeColor=#70a47d;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="55" y="740" width="1325" height="78" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
