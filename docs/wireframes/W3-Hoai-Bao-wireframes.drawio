y="380" width="570" height="45" as="geometry" /></mxCell><mxCell id="210" value="Vai trò *" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#ffffff;strokeColor=none;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="440" width="280" height="45" as="geometry" /></mxCell><mxCell id="211" value="Farmer   |   Processor   |   Distributor" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#ffffff;strokeColor=#9ca3af;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="380" y="440" width="570" height="45" as="geometry" /></mxCell><mxCell id="212" value="Đăng ký" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#1f3b73;strokeColor=#1f3b73;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="525" width="180" height="50" as="geometry" /></mxCell><mxCell id="213" value="Đã có tài khoản? Đăng nhập → UI-03" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#ffffff;strokeColor=none;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="580" y="525" width="370" height="50" as="geometry" /></mxCell><mxCell id="214" value="Lỗi tại trường nhập" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#fde2e2;strokeColor=#dc6b6b;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="90" y="620" width="860" height="76" as="geometry" /></mxCell><mxCell id="215" value="Đăng ký thành công: tài khoản đang chờ duyệt. Không tự mở Dashboard." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=15;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#e8f5e9;strokeColor=#70a47d;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="90" y="712" width="860" height="70" as="geometry" /></mxCell><mxCell id="216" value="Trạng thái nhập liệu" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#e8f0fe;strokeColor=#6b8fd6;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="122" width="350" height="36" as="geometry" /></mxCell><mxCell id="217" value="Thiếu trường, email sai định dạng hoặc xác nhận mật khẩu không khớp: báo sát trường. Không gửi yêu cầu." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#ffffff;strokeColor=#c8c8c8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1040" y="158" width="350" height="116" as="geometry" /></mxCell><mxCell id="218" value="Kết quả từ API" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#e8f0fe;strokeColor=#6b8fd6;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="298" width="350" height="36" as="geometry" /></mxCell><mxCell id="219" value="Email đã dùng: báo lỗi; giữ dữ liệu không nhạy cảm. Đang gửi: khóa nút. Thành công: PENDING và liên kết Đăng nhập." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#ffffff;strokeColor=#c8c8c8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1040" y="334" width="350" height="116" as="geometry" /></mxCell><mxCell id="220" value="Giới hạn quyền" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#e8f0fe;strokeColor=#6b8fd6;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="474" width="350" height="36" as="geometry" /></mxCell><mxCell id="221" value="Không cho chọn Admin hoặc tự gán đơn vị. Vai trò hợp lệ chỉ gồm Farmer, Processor, Distributor." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#ffffff;strokeColor=#c8c8c8;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1040" y="510" width="350" height="116" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="07 - Hồ sơ cá nhân" id="profile-w3"><mxGraphModel grid="1" gridSize="8" page="1" pageWidth="1440" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="222" value="UI-06  Hồ sơ cá nhân  |  US-UI03" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#1f2937;strokeColor=#1f2937;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1360" height="60" as="geometry" /></mxCell><mxCell id="223" value="Dashboard    Danh sách lô    Hồ sơ cá nhân    Đăng xuất" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#f4f5f7;strokeColor=#c8c8c8;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="118" width="930" height="58" as="geometry" /></mxCell><mxCell id="224" value="Thông tin tài khoản" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#e8f0fe;strokeColor=#6b8fd6;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="75" y="202" width="900" height="43" as="geometry" /></mxCell><mxCell id="225" value="Họ và tên" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#ffffff;strokeColor=none;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="