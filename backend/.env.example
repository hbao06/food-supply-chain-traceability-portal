# ---- Server ----
PORT=3000

# ---- Database ----
# Chạy backend trực tiếp trên máy: DB_HOST=localhost. Trong Docker Compose, DB_HOST đã được đặt là "database".
DB_HOST=localhost
DB_PORT=5432
DB_NAME=food_traceability
DB_USER=postgres
# Mật khẩu của tài khoản postgres trên máy bạn (với Docker Compose là: postgres). Không commit mật khẩu thật.
DB_PASSWORD=

# ---- Auth ----
# JWT_SECRET bắt buộc, dài tối thiểu 32 ký tự, KHÔNG commit giá trị thật. Tạo nhanh bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
BCRYPT_COST=10

# Số yêu cầu tối đa mỗi IP trong một cửa sổ thời gian; vượt thì 429.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_REGISTER_MAX=10

# ---- Tài khoản Admin đầu tiên (npm run db:seed:admin) ----
# Mật khẩu ≥ 8 ký tự, có chữ và số. KHÔNG commit giá trị thật.
ADMIN_NAME=Quản trị viên
ADMIN_EMAIL=
ADMIN_PASSWORD=