# ---- Server ----
PORT=3000

# ---- Database ----
# Chạy backend trực tiếp trên máy: DB_HOST=localhost. Trong Docker Compose, DB_HOST đã được đặt là "database".
DB_HOST=localhost
DB_PORT=5432
DB_NAME=food_traceability
DB_USER=postgres
# Mật khẩu của tài khoản postgres trên máy bạn (với Docker Compose là: postgres). Không commit mật khẩu thật.
DB_PASSWORD=

# ---- Auth ----
# JWT_SECRET bắt buộc, dài tối thiểu 32 ký tự, KHÔNG commit giá trị thật. Tạo nhanh bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
BCRYPT_COST=10

# Số yêu cầu tối đa mỗi IP trong một cửa sổ thời gian; vượt thì 429.
# ---- Giới hạn tần suất (W4-TV3) – tùy chọn ----
RATE_LIMIT_WINDOW_MINUTES=15
# Đăng nhập: số lần SAI tối đa cho mỗi IP + email (đăng nhập đúng không bị tính)
RATE_LIMIT_LOGIN_MAX=10
# Đăng ký: số lần tối đa mỗi IP
RATE_LIMIT_REGISTER_MAX=30
# Đặt true để tắt hẳn (smoke test, demo). Cũng tự tắt khi NODE_ENV=test.
RATE_LIMIT_DISABLED=false

# ---- Tài khoản Admin đầu tiên (npm run db:seed:admin) ----
# Mật khẩu ≥ 8 ký tự, có chữ và số. KHÔNG commit giá trị thật.
ADMIN_NAME=Quản trị viên
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- QR ----
# Khóa ký chữ ký HMAC của mã QR, >= 32 ký tự, KHÔNG commit giá trị thật (tạo giống JWT_SECRET)
QR_HMAC_SECRET=
# Trang truy xuất công khai mà mã QR trỏ tới
TRACE_BASE_URL=http://localhost:5173

# ---- CORS (W7-TV3) ----
# Nguồn (origin) được gọi API từ trình duyệt, phân tách bằng dấu phẩy. Bỏ trống = chỉ http://localhost:5173.
# Frontend gọi qua proxy của Vite nên thường không cần đổi. "*" = cho mọi website (không khuyến nghị).
CORS_ORIGIN=http://localhost:5173
